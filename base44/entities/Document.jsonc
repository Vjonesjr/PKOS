{
  "name": "Document",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "file_uri": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    },
    "size": {
      "type": "number"
    },
    "content_hash": {
      "type": "string",
      "description": "SHA-256 of the file, used to detect re-imports"
    },
    "status": {
      "type": "string",
      "enum": [
        "uploaded",
        "processing",
        "ready",
        "failed"
      ],
      "default": "uploaded"
    },
    "summary": {
      "type": "string"
    },
    "extracted_text": {
      "type": "string",
      "description": "Capped extracted text for search/reference"
    },
    "extraction_method": {
      "type": "string",
      "enum": [
        "direct",
        "ai"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "project_id": {
      "type": "string"
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "sent_type": {
            "type": "string"
          },
          "sent_id": {
            "type": "string"
          }
        }
      }
    },
    "whole_sent_type": {
      "type": "string"
    },
    "whole_sent_id": {
      "type": "string"
    },
    "processed_date": {
      "type": "string",
      "format": "date"
    },
    "error": {
      "type": "string"
    },
    "workspace": {
      "type": "string",
      "enum": [
        "personal",
        "demo"
      ],
      "default": "personal"
    }
  },
  "required": [
    "file_uri",
    "file_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}