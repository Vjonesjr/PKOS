{
  "name": "Capture",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "idea",
        "note",
        "task",
        "question",
        "project_thought",
        "learning_note",
        "decision",
        "lesson",
        "reference",
        "prompt"
      ],
      "default": "idea"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "project_id": {
      "type": "string"
    },
    "knowledge_id": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "important": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "inbox",
        "processed",
        "archived"
      ],
      "default": "inbox"
    },
    "converted_to_type": {
      "type": "string"
    },
    "converted_to_id": {
      "type": "string"
    }
  },
  "required": [
    "content"
  ]
}