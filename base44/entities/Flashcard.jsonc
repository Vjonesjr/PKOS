{
  "name": "Flashcard",
  "type": "object",
  "properties": {
    "front": {
      "type": "string"
    },
    "back": {
      "type": "string"
    },
    "learning_item_id": {
      "type": "string"
    },
    "knowledge_id": {
      "type": "string"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "review_count": {
      "type": "number",
      "default": 0
    },
    "next_review_date": {
      "type": "string",
      "format": "date"
    },
    "workspace": {
      "type": "string",
      "enum": [
        "personal",
        "demo"
      ],
      "default": "personal"
    }
  },
  "required": [
    "front",
    "back"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}