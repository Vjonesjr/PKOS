{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Every morning at 7am, sends today's open tasks to Google Calendar",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "morning_agenda_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "push_agenda": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "morningAgendaSync",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send today's tasks to Calendar"
          }
        }
      }
    ]
  },
  "name": "Morning Agenda Sync"
}